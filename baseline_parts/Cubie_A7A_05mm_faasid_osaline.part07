        const p=project(modelPoint);if(!p)continue;
        const text=item.name+'  '+(modelPoint[0]-originX).toFixed(1)+' / '+(modelPoint[1]-originY).toFixed(1)+' mm';
        const tx=p[0]+item.shift[0]*k,ty=p[1]+item.shift[1]*k;
