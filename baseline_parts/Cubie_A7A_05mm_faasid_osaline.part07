    let dragItem=null;
    function findJack(x,y){
      let best=null,bestD=28;
      for(const item of coordPoints){
        if(!item.movable)continue;
        const group=groups.find(g=>g.name.startsWith(item.movable));
        if(!group||!group.visible)continue;
        const state=item.deviceId?xlrStates.find(s=>s.id===item.deviceId):null;const q=project(state?xlrWorldPoint(state,[0,0,-7]):item.p);if(!q)continue;
        const d=Math.hypot(q[0]/(labelCanvas.width/w)-x,q[1]/(labelCanvas.height/h)-y);
