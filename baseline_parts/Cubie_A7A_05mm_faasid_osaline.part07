        else if(gridVisibility>0) {const p=project([t,originY,0]);if(p){ctx.fillStyle=`rgba(255,133,133,${.65*gridVisibility})`;ctx.fillRect(p[0]-1*k,p[1]-1*k,2*k,2*k);}}
      }
      for(let t=originY;t<=100;t+=10){
        if((t-originY)%20===0) tick([originX,t,0],'#84f3b7',String(t-originY));
        else if(gridVisibility>0) {const p=project([originX,t,0]);if(p){ctx.fillStyle=`rgba(132,243,183,${.65*gridVisibility})`;ctx.fillRect(p[0]-1*k,p[1]-1*k,2*k,2*k);}}
      }
      for(let t=20;t<=60;t+=20)tick([originX,originY,t],'#a4b8ff',String(t));
      tick([160,originY,0],'#ff7070','X mm');tick([originX,100,0],'#77eaa4','Y mm');tick([originX,originY,68],'#88aaff','Z mm');
      for(let t=originY+10;t<=100;t+=20)tick([160,t,0],'#84f3b7',String(t-originY));
      for(let t=20;t<=60;t+=20)tick([160,originY,t],'#a4b8ff',String(t));
      tick([160,100,0],'#77eaa4','Y mm');tick([160,originY,68],'#88aaff','Z mm');
