          if(c&&xp&&yp){const k=labelCanvas.width/w,a=(xp[0]-c[0])/k,b=(yp[0]-c[0])/k,cc=(xp[1]-c[1])/k,d=(yp[1]-c[1])/k,det=a*d-b*cc;
